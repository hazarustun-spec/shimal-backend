# === Shimal Backend Environment Variables ===
# Copy this file to .env and fill in your real values.

# --- Supabase ---
# Go to https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Anthropic (Claude AI) ---
# Go to https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- OneSignal (Push Notifications) ---
# Go to https://onesignal.com → your app → Settings → Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Cron API Key (simple protection for cron endpoints) ---
CRON_API_KEY=generate-a-random-string-here

# --- Shimal API Key (iOS app authentication) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHIMAL_API_KEY=generate-a-64-char-hex-string-here
# Set to 'false' to log but not reject missing API keys (during iOS rollout)
API_KEY_ENFORCE=false

# --- CORS (optional, leave empty for mobile-only API) ---
# CORS_ORIGIN=https://yourdomain.com
