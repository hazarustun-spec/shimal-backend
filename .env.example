# === Shimal Backend Environment Variables ===
# Copy this file to .env and fill in your real values.

# --- Supabase ---
# Go to https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Gemini (AI yorumlama) ---
# https://aistudio.google.com/apikey → Create API key
# ZORUNLU: tanımlı değilse süreç başlangıçta process.exit(1) yapar.
GEMINI_API_KEY=AIza-xxxxx
# Opsiyonel, varsayılan: gemini-3.1-flash-lite
# gemini-2.5-* ailesi yeni API key'lerine kapatıldı ("no longer available to
# new users" → 404). Model değiştirirsen 3.x ailesinden seç.
# DİKKAT: "flash" modelleri (3.6-flash gibi) düşünmeyi kapatmaya izin vermiyor
# ve düşünme token'ları çıktı olarak faturalanıyor → içgörü başına ~10 kat
# maliyet. Lite modeller düşünmüyor.
# GEMINI_MODEL=gemini-3.1-flash-lite
#
# Opsiyonel, varsayılan: 3. Yalnızca "flash" modeline geçersen anlamlı — düşünme
# token'ları maxOutputTokens bütçesinden düşüyor. Loglarda
# "[Gemini] Çıktı kırpıldı (MAX_TOKENS)" görürsen bunu artır.
# GEMINI_THINKING_HEADROOM=3

# --- OneSignal (Push Notifications) ---
# Go to https://onesignal.com → your app → Settings → Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Cron API Key (simple protection for cron endpoints) ---
CRON_API_KEY=generate-a-random-string-here

# --- Shimal API Key (iOS app authentication) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production'da ZORUNLU. Tanımlı değilse tüm /api/* istekleri 503 ile reddedilir.
# Development'ta tanımlı değilse sadece uyarı loglanır, istekler geçer.
SHIMAL_API_KEY=generate-a-64-char-hex-string-here

# --- Shimal API Key (önceki / rotasyon geçiş dönemi) ---
# Yalnızca anahtar rotasyonu sırasında tanımla. Yayınlanmış iOS sürümleri eski
# anahtarı gömülü taşır; yeni sürüm yaygınlaşana kadar eskisi de kabul edilmeli.
# Kullanıldıkça saatlik uyarı loglanır — sayı sıfırlanınca bu satırı sil.
# ÖNEMLİ: rotasyondan ÖNCE SHIMAL_SESSION_SECRET'i eski anahtarın değerine
# sabitle, yoksa ondan türeyen legacy session token'ları geçersizleşir.
# SHIMAL_API_KEY_PREVIOUS=the-key-you-are-rotating-away-from

# --- Shimal Session Secret (HMAC-based device session tokens) ---
# Opsiyonel. Tanımlı değilse SHIMAL_API_KEY'den türetilir.
# Bu secret değişirse TÜM aktif session token'lar geçersizleşir — kullanıcılar
# yeniden kayıt gerektirecek bir mesajla karşılaşır. Rotasyon için kullan.
# SHIMAL_SESSION_SECRET=generate-a-64-char-hex-string-here

# --- CORS (optional, leave empty for mobile-only API) ---
# CORS_ORIGIN=https://yourdomain.com

# --- Sign in with Apple ---
# Opsiyonel. Tanımlı değilse 'com.shimal.app' varsayılır.
# APPLE_BUNDLE_ID=com.shimal.app

# --- RevenueCat webhook ---
# RevenueCat → Integrations → Webhooks → Authorization header değeri.
REVENUECAT_WEBHOOK_SECRET=

# --- Admin dashboard ---
# Railway'de RAILWAY_PUBLIC_DOMAIN'den türetiliyordu; Render'da o değişken yok.
# Servisin public URL'ini elle gir, yoksa dashboard CORS'u '*' olur.
# DASHBOARD_ORIGIN=https://shimal-backend.onrender.com
# DASHBOARD_PASSWORD_HASH=
# DASHBOARD_SECRET=

# --- Sentry (opsiyonel) ---
# SENTRY_DSN=
