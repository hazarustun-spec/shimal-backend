# === AstroGuide Backend Environment Variables ===
# Copy this file to .env and fill in your real values.

# --- Supabase ---
# Go to https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Anthropic (Claude AI) ---
# Go to https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- OneSignal (Push Notifications) ---
# Go to https://onesignal.com → your app → Settings → Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-rest-api-key

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Cron API Key (simple protection for cron endpoints) ---
CRON_API_KEY=generate-a-random-string-here
